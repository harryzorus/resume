FROM ubuntu:24.04

LABEL org.opencontainers.image.source="https://github.com/harishneit/resume"
LABEL org.opencontainers.image.description="CI build environment for resume (XeLaTeX)"

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       git \
       texlive-xetex \
       texlive-fonts-recommended \
       latexmk \
    && rm -rf /var/lib/apt/lists/*
