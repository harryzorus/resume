% editorial callout (manual drop cap inside tinted box)
% #1 = drop cap letter, #2 = rest of first word (small caps), #3 = body
\newcommand{\editorialcallout}[3]{%
  \par\noindent
  \hspace{0.6em}%
  \begin{minipage}{\dimexpr\textwidth-1.2em\relax}%
    \vspace{0.4em}%
    \setlength{\parindent}{0pt}%
    \hangindent=3.4em\hangafter=-3\relax
    \noindent
    \llap{\smash{\raisebox{-2\baselineskip}[0pt][0pt]{%
      \makebox[3.4em][c]{\HelioBlackDisplay\fontsize{50}{50}\selectfont\color{color1}#1}%
    }}}%
    {\bfseries\color{color0}#2}\space{\color{color0}#3}%
    \vspace{0.4em}%
  \end{minipage}%
  \par}

% employer header with crimson hairline underline + PDF bookmark
\newcommand{\employerheader}[1]{%
  \addvspace{1.2em}%
  \phantomsection%
  \pdfbookmark[2]{#1}{employer.\detokenize{#1}}%
  \par\noindent{\bfseries\addfontfeature{LetterSpace=1} #1}%
  \par\vspace{0.15em}%
  {\color{color1!40}\hrule height 0.4pt}%
  \nopagebreak[4]%
  \par\vspace{0.5em}}

% work mode label (Remote / Onsite) — crimson accent, upshape to cancel italic from cventry role
\newcommand{\workmode}[1]{\enspace{\upshape\textcolor{color2}{\textperiodcentered\enspace{\footnotesize #1}}}}

% multi-location separator (arrow between locations)
\newcommand{\locand}{\,{\color{color2}{\footnotesize\textrightarrow}}\,}

% job role entry — purpose-built for Experience section
% \cvrole[spacing]{dates}{title}{team}{location}{workmode}
\newcommand*{\cvrole}[6][.35em]{%
  \begin{tabular*}{\textwidth}{l@{\extracolsep{\fill}}r}%
    {\itshape #3\ifthenelse{\equal{#6}{}}{}{%
      \workmode{#6}}%
      \ifx&#4&\else{\enspace{\upshape\textcolor{color2}{\textperiodcentered\enspace{\HelioBook\footnotesize #4}}}}\fi} &
      {\HelioBook\small\color{color2}#5\ifthenelse{\equal{#2}{}}{}{\enspace\textperiodcentered\enspace #2}}\\%
  \end{tabular*}%
