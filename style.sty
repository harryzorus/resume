% fonts — Heliotrope loaded via fonts.sty

% Phosphor icon inline command (font loaded in fonts.sty)
% Default: renders at current font size
\newcommand{\phicon}[1]{{\PhosphorFont\char"#1\relax}}
% Sized variant for contact line (addressfont is \small ~ 9.5pt)
\newcommand{\phiconcontact}[1]{\raisebox{-0.06ex}{\fontsize{8}{8}\selectfont\phicon{#1}}}
% Sized variant for section headers (match HelioCaps small-cap x-height)
\newcommand{\phiconsection}[1]{\raisebox{0.05ex}{\fontsize{8.5}{8.5}\selectfont\phicon{#1}}}
% Sized variant for inline project icons (subordinate to body text)
\newcommand{\phiconinline}[1]{\raisebox{-0.06ex}{\fontsize{8}{8}\selectfont\phicon{#1}}}

% symbols
\renewcommand*{\mobilesymbol}{\phicon{E45A}~}   % phone
\renewcommand*{\phonesymbol}{\phicon{E45A}~}     % phone
\renewcommand*{\faxsymbol}{\phicon{E218}~}       % envelope-simple
\renewcommand*{\emailsymbol}{\phicon{E218}~}     % envelope-simple
\renewcommand*{\homepagesymbol}{\phicon{E288}~}  % globe

% commands
\newcommand*{\maketitlesymbol}{%
    {\hspace{0.9em}{\color{color2}\textperiodcentered}\hspace{0.9em}}}% middle dot separator
%   internal command to add an element to the footer
%   it collects the elements in a temporary box, and checks when to flush the box
\newsavebox{\maketitlebox}%
\newsavebox{\maketitletempbox}%
\newlength{\maketitlewidth}%
\newlength{\maketitleboxwidth}%
\newif\if@firstmaketitleelement\@firstmaketitleelementtrue%
%   adds an element to the maketitle, separated by maketitlesymbol
%   usage: \addtomaketitle[maketitlesymbol]{element}
\newcommand*{\addtomaketitle}[2][\maketitlesymbol]{%
  \if@firstmaketitleelement%
    \savebox{\maketitletempbox}{\usebox{\maketitlebox}#2}%
  \else%
    \savebox{\maketitletempbox}{\usebox{\maketitlebox}#1#2}\fi%
  \settowidth{\maketitleboxwidth}{\usebox{\maketitletempbox}}%
  \ifnum\maketitleboxwidth<\maketitlewidth%
    \savebox{\maketitlebox}{\usebox{\maketitletempbox}}%
    \@firstmaketitleelementfalse%
  \else%
    \flushmaketitle{}\\%
    \savebox{\maketitlebox}{#2}%
    \savebox{\maketitletempbox}{#2}%
    \settowidth{\maketitleboxwidth}{\usebox{\maketitlebox}}%
    \@firstmaketitleelementfalse\fi}
%   internal command to flush the maketitle
\newcommand*{\flushmaketitle}{%
  \strut\usebox{\maketitlebox}%
  \savebox{\maketitlebox}{}%
  \savebox{\maketitletempbox}{}%
  \setlength{\maketitleboxwidth}{0pt}}
\renewcommand*{\maketitle}{%
  \begin{center}%
    \namestyle{\@firstname~\@familyname}%
    \ifthenelse{\isundefined{\@addressstreet}}{}{\\[0.3em]\titlestyle{\@addressstreet}}%
    \\[0.4em]%
    {\addressfont\color{color2}%
      \ifthenelse{\isundefined{\@email}}{}{{\phiconcontact{E218}\,\emaillink{\@email}}}%
      \ifthenelse{\isundefined{\@homepage}}{}{%
        \maketitlesymbol%
        \ifthenelse{\equal{\@homepagetitle}{}}%
          {{\phiconcontact{E288}\,\httplink{\@homepage}}}%
          {{\phiconcontact{E288}\,\httplink[\@homepagetitle]{\@homepage}}}}%
      \ifthenelse{\isundefined{\@github}}{}{%
        \maketitlesymbol%
        \ifthenelse{\equal{\@githuburl}{}}%
          {{\phiconcontact{E576}\,\httplink{\@github}}}%
          {{\phiconcontact{E576}\,\httplink[\@github]{\@githuburl}}}}%
      \ifthenelse{\isundefined{\@linkedin}}{}{%
        \maketitlesymbol%
        \ifthenelse{\equal{\@linkedinurl}{}}%
          {{\phiconcontact{E2EE}\,\httplink{\@linkedin}}}%
          {{\phiconcontact{E2EE}\,\httplink[\@linkedin]{\@linkedinurl}}}}%
    }%
  \end{center}%
  \vspace{0.4em}%
  % Double-rule masthead: thin-thick bottom
  \noindent\leavevmode\vbox{%
    {\color{color1}\hrule height 0.4pt}%
    \vskip2pt%
    {\color{color1}\hrule height 1.2pt}%
  }\par\vspace{0.2em}}


