% role context callout — full-bleed tinted card with crimson left accent
% Sets the team/project context before contribution bullets.
% Empty argument suppresses the block entirely (zero extra space).
\newcommand{\rolecontext}[1]{%
  \ifx&#1&\else
  \par\addvspace{0.25em}%
  \noindent%
  \begin{tikzpicture}
    \node[
      inner xsep=0.8em, inner ysep=0.5em,
      fill=color1!6,
      text width={\dimexpr\textwidth-1.6em-3pt},
      anchor=west,
      xshift=3pt
    ] (ctx) {{\HelioBook\small\itshape\color{color0}#1}};
    \fill[color1] ([xshift=-3pt]ctx.north west) rectangle (ctx.south west);
  \end{tikzpicture}%
  \par\addvspace{0.35em}%
  \fi}

