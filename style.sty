% --- Open Source card layout ---

% Card geometry (parameterized columns)
\newlength{\oscardpad}\setlength{\oscardpad}{0.55em}%
\newlength{\oscardgap}\setlength{\oscardgap}{0.5em}%
\newlength{\oscardbar}\setlength{\oscardbar}{1.5pt}%
\newlength{\oscardinner}%
\newcount\oscardcols
% \setoscardcols{N} — configure card layout for N columns
% per card = bar + pad + inner + pad; N cards + (N-1) gaps = textwidth
\newcommand{\setoscardcols}[1]{%
  \oscardcols=#1\relax
  % step-by-step: avoids dimexpr parsing issues with nested \numexpr
  \setlength{\oscardinner}{\textwidth}%
  \addtolength{\oscardinner}{-\numexpr\oscardcols-1\relax\oscardgap}%
  \setlength{\oscardinner}{\dimexpr\oscardinner/\oscardcols\relax}%
  \addtolength{\oscardinner}{-2\oscardpad}%
  \addtolength{\oscardinner}{-\oscardbar}%
}
\AtBeginDocument{\setoscardcols{3}}% deferred: geometry must set \textwidth first

% Card content: #1=name, #2=github-url, #3=page-url, #4=description, #5=tech stack
\newcommand{\oscardcontent}[5]{%
  \vspace{0.5em}%
  \begin{tabular*}{\oscardinner}{@{}l@{\extracolsep{\fill}}r@{}}%
    {\TriplicateCode\fontsize{10.5}{12}\selectfont\textcolor{color1}{\href{#2}{#1}}} &
    {\textcolor{color1}{\href{#3}{\raisebox{-0.08ex}{\fontsize{9}{9}\selectfont\phicon{E2C6}}}}\kern0.4em
     \textcolor{color1}{\href{#2}{\raisebox{-0.08ex}{\fontsize{9}{9}\selectfont\phicon{E278}}}}}%
  \end{tabular*}%
  \par\vspace{0.25em}%
  {\raggedright\HelioBook\small\color{color0} #4\par}%
  \vfill
  \vspace{0.4em}%
  {\color{color1!30}\hrule height 0.4pt}%
  \par\vspace{0.3em}%
  {\HelioBook\footnotesize\textcolor{color2}{#5}\par}%
  \vspace{0.5em}\mbox{}%
}

% Render one card: #1=height (empty=natural), #2..#6=content args
\newsavebox{\osctmpbox}%
\newcommand{\oscard}[6]{%
  {\sbox{\osctmpbox}{%
     \if\relax\detokenize{#1}\relax
       \begin{minipage}[t]{\oscardinner}%
     \else
       \begin{minipage}[t][#1]{\oscardinner}%
     \fi
       \oscardcontent{#2}{#3}{#4}{#5}{#6}%
     \end{minipage}%
   }%
   \textcolor{color1}{\rule[\dimexpr-\dp\osctmpbox]{\oscardbar}{\dimexpr\ht\osctmpbox+\dp\osctmpbox}}%
   \kern\oscardpad
   \usebox{\osctmpbox}%
   \kern\oscardpad
  }%
}

% --- Card collection & auto-render system ---
\newcount\oscardcount\oscardcount=0\relax
\newcount\osidx
\newlength{\osmaxht}\newlength{\ostmpht}\newlength{\oscardht}%

% \addoscard{name}{github-url}{page-url}{description}{tech stack}
\newcommand{\addoscard}[5]{%
  \global\advance\oscardcount by 1\relax
  \expandafter\gdef\csname osc@\the\oscardcount @a\endcsname{#1}%
  \expandafter\gdef\csname osc@\the\oscardcount @b\endcsname{#2}%
  \expandafter\gdef\csname osc@\the\oscardcount @c\endcsname{#3}%
  \expandafter\gdef\csname osc@\the\oscardcount @d\endcsname{#4}%
  \expandafter\gdef\csname osc@\the\oscardcount @e\endcsname{#5}%
}

% internal: measure card N into \osctmpbox, update \osmaxht
\newcommand{\os@measure}{%
  \advance\osidx by 1\relax
  \ifnum\osidx>\oscardcount\else
    \sbox{\osctmpbox}{\oscard{}%
      {\csname osc@\the\osidx @a\endcsname}%
      {\csname osc@\the\osidx @b\endcsname}%
      {\csname osc@\the\osidx @c\endcsname}%
      {\csname osc@\the\osidx @d\endcsname}%
      {\csname osc@\the\osidx @e\endcsname}}%
    \setlength{\ostmpht}{\dimexpr\ht\osctmpbox+\dp\osctmpbox\relax}%
    \ifdim\ostmpht>\osmaxht\setlength{\osmaxht}{\ostmpht}\fi
    \os@measure
  \fi
}

% internal: render card N at \oscardht, with gap before if N>1
\newcommand{\os@render}{%
  \advance\osidx by 1\relax
  \ifnum\osidx>\oscardcount\else
    \ifnum\osidx>1\hspace{\oscardgap}\fi
    \oscard{\oscardht}%
      {\csname osc@\the\osidx @a\endcsname}%
      {\csname osc@\the\osidx @b\endcsname}%
      {\csname osc@\the\osidx @c\endcsname}%
      {\csname osc@\the\osidx @d\endcsname}%
      {\csname osc@\the\osidx @e\endcsname}%
    \os@render
  \fi
}

% \renderoscards — auto-compute columns, match heights, render all cards
\newcommand{\renderoscards}{%
  \setoscardcols{\the\oscardcount}%
  \setlength{\osmaxht}{0pt}%
  \osidx=0\relax\os@measure
  \setlength{\oscardht}{\dimexpr\osmaxht-2\oscardpad\relax}%
  \noindent\osidx=0\relax\os@render
  \par\addvspace{0.3ex}%
  \global\oscardcount=0\relax
}

